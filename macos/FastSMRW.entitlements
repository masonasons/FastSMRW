<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: media plays through FastPlay's engine, which runs yt-dlp
	     (and deno) for YouTube links, and a sandbox would stop them. The app is
	     still hardened-runtime signed and notarized. Settings made while it was
	     sandboxed are brought out of the old container on first run
	     (AppState.moveOutOfSandbox). -->
</dict>
</plist>
