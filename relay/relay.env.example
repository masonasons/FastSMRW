# FastSMRW push relay configuration. Copy to /etc/fastsm-push-relay/relay.env
# (chmod 640, owned by root) and fill in. Loaded by the systemd unit.

# Local address the relay listens on (it sits behind a TLS reverse proxy).
RELAY_LISTEN=127.0.0.1:8787

# The PUBLIC https URL the relay is reachable at, no trailing slash. Endpoint
# URLs handed to the app are <this>/push/<id>. Must be HTTPS (Mastodon requires
# it). Match this to your reverse-proxy route (see README).
RELAY_PUBLIC_BASE=https://brynify.me/fastsm-push

# APNs auth for iOS (from the Apple Developer portal). The .p8 is a secret —
# keep it only in /etc/fastsm-push-relay, mode 600, never in git. APNS_KEY_PATH
# is set by the systemd unit via LoadCredential (do not set it here). Leave the
# whole block out on a relay that only serves Android.
APNS_KEY_ID=DA36MM9RZR
APNS_TEAM_ID=9QBYDAX396
APNS_BUNDLE_ID=me.masonasons.FastSMRW

# Firebase Cloud Messaging for Android. FCM_PROJECT_ID is the Firebase project
# id (leave blank to take it from the key file). The service-account JSON is a
# secret and is passed in by the systemd unit via LoadCredential, so do not set
# FCM_SERVICE_ACCOUNT here. Leave this blank on an iOS-only relay.
FCM_PROJECT_ID=

# Where the endpoint-id -> device map is persisted (StateDirectory).
RELAY_STORE=/var/lib/fastsm-push-relay/devices.json

# Optional shared secret the app must send on /register (Bearer). Leave blank to
# disable. If set, the app's push_subscribe must send the same value.
RELAY_REGISTER_TOKEN=
